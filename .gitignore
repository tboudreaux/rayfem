# Build trees and local dependency installs (build-config/ is source)
/build/
/build-*/
!/build-config/
.rayfem-deps/

# Python packaging and environments
__pycache__/
*.py[cod]
*.egg-info/
dist/
venv/
.venv/

# Subprojects the wraps download; local patches live in packagefiles/
subprojects/*/
!subprojects/packagefiles/

# Viewer state and exports
imgui.ini
rayfem-exports/

# Editors and operating systems
.idea/
.vscode/
*.swp
.DS_Store
